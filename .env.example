# Copy to .env and adjust. docker-compose.yml reads it if present.

# Where users reach Saldo. Cookie writes must come from this origin, and the
# session cookie is marked Secure when this is https.
SALDO_PUBLIC_URL=http://localhost:8080

# Log level or tracing filter, for example: info, debug, saldo=debug,info
SALDO_LOG=info

# Set inside the image; change only if you know why.
# SALDO_DATABASE_URL=sqlite:///data/saldo.db
# SALDO_DATA_DIR=/data
# SALDO_BIND=0.0.0.0:8080

# For saldo-import: the Firefly III personal access token. Prefer passing it
# for one command (see README) over storing it here.
# FIREFLY_TOKEN=
