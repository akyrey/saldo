# Copy to .env and adjust. docker-compose.yml reads it if present.

# Where users reach Saldo. Cookie writes must come from this origin, and the
# session cookie is marked Secure when this is https.
SALDO_PUBLIC_URL=http://localhost:8080
# Origins allowed to call the API cross-origin (CORS), comma-separated. Set it
# for the desktop app: tauri://localhost (macOS, Linux) and http://tauri.localhost
# (Windows). Empty: CORS off.
SALDO_ALLOWED_ORIGINS=

# "Log in with Authentik" (OpenID Connect). Create an OAuth2/OpenID provider
# in Authentik (confidential client, redirect URI
# <SALDO_PUBLIC_URL>/api/v1/auth/oidc/callback, scopes openid email profile)
# and copy its issuer, client ID and secret here. People log in when their
# verified email matches a household member's.
SALDO_OIDC_ISSUER=
SALDO_OIDC_CLIENT_ID=
SALDO_OIDC_CLIENT_SECRET=
# true: accept the provider's emails as verified. Authentik reports
# email_verified=false unless a scope mapping sets it; with your own Authentik,
# whose admin sets every email, true is safe.
SALDO_OIDC_TRUST_EMAIL=false
# Name on the login button (default Authentik).
SALDO_OIDC_NAME=
# Set to false to allow only the identity provider (needs SALDO_OIDC_*).
SALDO_PASSWORD_LOGIN=true

# Log level or tracing filter, for example: info, debug, saldo=debug,info
SALDO_LOG=info

# Set inside the image; change only if you know why.
# SALDO_DATABASE_URL=sqlite:///data/saldo.db
# SALDO_DATA_DIR=/data
# SALDO_BIND=0.0.0.0:8080

# Email reminders (optional). Without SALDO_SMTP_HOST, email channels are off.
# SALDO_SMTP_HOST=smtp.example.com
# SALDO_SMTP_PORT=587                 # default: 587 starttls, 465 tls, 25 none
# SALDO_SMTP_TLS=starttls             # starttls | tls | none
# SALDO_SMTP_USER=saldo@example.com   # set USER and PASSWORD together, or neither
# SALDO_SMTP_PASSWORD=
# SALDO_SMTP_FROM=Saldo <saldo@example.com>

# Web Push (optional). Generate a key pair with `saldo vapid-keys`.
# SALDO_VAPID_PRIVATE_KEY=
# Contact sent to push services; defaults to SALDO_PUBLIC_URL when it is https.
# SALDO_VAPID_SUBJECT=mailto:you@example.com

# For saldo-import: the Firefly III personal access token. Prefer passing it
# for one command (see README) over storing it here.
# FIREFLY_TOKEN=
