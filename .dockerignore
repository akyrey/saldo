# Keep the build context small and free of local data and secrets.
target/
**/target/
.git/
web/node_modules/
web/dist/
data/
*.db
*.db-wal
*.db-shm
.env
# The image's own Rust version is used; the toolchain file would download another.
rust-toolchain.toml
# The desktop app is built separately (desktop/, not part of the image).
desktop/
web/test-results/
web/playwright-report/
